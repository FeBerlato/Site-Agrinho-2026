/*básico*/
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/*cores (variaveis)*/
:root {
    --cor-principal: #1b831f;
    --cor-secundaria: #16611a;
    --cor-fundo: #f5f5f5;
    --cor-texto: #333333;
    --cor-branco: #ffffff;
}

/*quando modo escuro*/
body.modo-escuro {
    --cor-fundo: #332c2c;
    --cor-texto: #7c2121;
    --cor-principal: #332c2c;
    --cor-secundaria: #7c2121
    ;
}

body {
    font-family: Arial, sans-serif;
    background-color: var(--cor-fundo);
    color: var(--cor-texto);
    line-height: 1.6;
    transition: background-color 0.3s, color 0.3s;
}

/*Cabeçalho*/
#cabecalho {
    background-color: var(--cor-principal);
    color: var(--cor-branco);
    padding: 20px;
    text-align: center;
}

#cabecalho h1 {
    font-size: 1.8rem;
    margin-bottom: 10px;
}

/*Navegação*/
.navegacao {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 15px;
    flex-wrap: wrap;
}

.navegacao a {
    color: var(--cor-branco);
    text-decoration: none;
    padding: 8px 15px;
    background-color: var(--cor-secundaria);
    border-radius: 5px;
    transition: background-color 0.3s;
}

.navegacao a:hover {
    background-color: #66bb6a;
}

/*Controles*/
#controles {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 15px;
    background-color: var(--cor-secundaria);
    flex-wrap: wrap;
}

#controles button {
    padding: 8px 15px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    background-color: var(--cor-branco);
    color: var(--cor-texto);
    transition: transform 0.2s, background-color 0.3s;
}

#controles button:hover {
    transform: scale(1.05);
    background-color: #e8f5e9;
}

/*Espaço principal*/
.container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
}

/*Seções*/
.secao {
    background-color: var(--cor-branco);
    margin-bottom: 20px;
    padding: 20px;
    border-radius: 8px;
    border-left: 4px solid var(--cor-principal);
}

body.modo-escuro .secao {
    background-color: #2d2d2d;
}

.secao h2 {
    color: var(--cor-principal);
    margin-bottom: 15px;
    font-size: 1.4rem;
}

/*Formulário*/
#formulario-contato {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

#formulario-contato label {
    font-weight: bold;
    color: var(--cor-principal);
}

#formulario-contato input,
#formulario-contato textarea {
    padding: 10px;
    border: 2px solid var(--cor-secundaria);
    border-radius: 5px;
    font-size: 1rem;
    transition: border-color 0.3s;
}

#formulario-contato input:focus,
#formulario-contato textarea:focus {
    border-color: var(--cor-principal);
    outline: none;
}

#formulario-contato button {
    padding: 12px;
    background-color: var(--cor-principal);
    color: var(--cor-branco);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1rem;
    transition: background-color 0.3s, transform 0.2s;
}

#formulario-contato button:hover {
    background-color: #1b5e20;
    transform: scale(1.02);
}

/*Mensagem de boas-vindas*/
#mensagem-usuario {
    background-color: #e8f5e9;
    padding: 15px;
    border-radius: 5px;
    margin-bottom: 20px;
    display: none;
    text-align: center;
    font-size: 1.1rem;
}

body.modo-escuro #mensagem-usuario {
    background-color: #1b5e20;
}

/*Quiz super radical e dificil*/
#area-quiz {
    margin-top: 15px;
}

.opcao-quiz {
    display: block;
    width: 100%;
    padding: 10px;
    margin: 8px 0;
    background-color: var(--cor-secundaria);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.3s, transform 0.2s;
}

.opcao-quiz:hover {
    background-color: var(--cor-principal);
    color: var(--cor-branco);
    transform: translateX(5px);
}

#resultado-quiz {
    margin-top: 15px;
    padding: 15px;
    border-radius: 5px;
    display: none;
    font-weight: bold;
}

.resposta-certa {
    background-color: #c8e6c9;
    color: #2e7d32;
}

.resposta-errada {
    background-color: #ffcdd2;
    color: #c62828;
}

body.modo-escuro .resposta-certa {
    background-color: #2e7d32;
    color: #ffffff;
}

body.modo-escuro .resposta-errada {
    background-color: #c62828;
    color: #ffffff;
}

/*Contador*/
#contador-visitas {
    text-align: center;
    padding: 10px;
    background-color: var(--cor-principal);
    color: var(--cor-branco);
    border-radius: 5px;
    margin-bottom: 20px;
}

/*Dicas importantes*/
#lista-dicas {
    list-style: none;
}

#lista-dicas li {
    padding: 10px;
    margin: 8px 0;
    background-color: #e8f5e9;
    border-radius: 5px;
    transition: background-color 0.3s;
}

body.modo-escuro #lista-dicas li {
    background-color: #2e7d32;
}

#lista-dicas li:hover {
    background-color: var(--cor-secundaria);
}

/*Botão de mostrar mais*/
#btn-mostrar-dicas {
    padding: 10px 20px;
    background-color: var(--cor-principal);
    color: var(--cor-branco);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    margin-top: 10px;
    transition: background-color 0.3s;
}

#btn-mostrar-dicas:hover {
    background-color: #1b5e20;
}

#dicas-extras {
    display: none;
    margin-top: 15px;
}

/* para o rodapé*/
#rodape {
    background-color: var(--cor-principal);
    color: var(--cor-branco);
    text-align: center;
    padding: 20px;
    margin-top: 30px;
}

/*medias para o funcionamento*/
@media (max-width: 768px) {
    #cabecalho h1 {
        font-size: 1.4rem;
    }

    .navegacao {
        flex-direction: column;
        align-items: center;
    }

    .navegacao a {
        width: 80%;
        text-align: center;
    }

    #controles {
        flex-direction: column;
        align-items: center;
    }

    #controles button {
        width: 80%;
    }

    .container {
        padding: 10px;
    }

    .secao {
        padding: 15px;
    }
}

@media (max-width: 480px) {
    #cabecalho h1 {
        font-size: 1.2rem;
    }

    .secao h2 {
        font-size: 1.2rem;
    }
}
